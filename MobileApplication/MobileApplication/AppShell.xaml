<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MobileApplication.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MobileApplication"
    xmlns:pages="clr-namespace:MobileApplication.Pages"
    Shell.FlyoutBehavior="Disabled"
    Title="MobileApplication">

    <ShellContent
        Title="Home Page"
        ContentTemplate="{DataTemplate pages:HomePage}"
        Route="HomePage" />

    <!-- Shown by HomePage when no user is stored on the device: on first run, or after the app's data was cleared. -->
    <ShellContent
        Title="Welcome"
        ContentTemplate="{DataTemplate pages:WelcomePage}"
        Route="WelcomePage" />

</Shell>
